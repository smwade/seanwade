# Keep the real key in .env.local, never a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
PORT=4174
# Production also requires NODE_ENV=production, an HTTPS origin, a persistent
# CHAT_DATA_DIR, and CHAT_COOKIE_SECRET with at least 32 random characters.
# CHAT_ORIGIN=https://seanwade.com
# CHAT_COOKIE_SECRET=
# CHAT_DATA_DIR=/persistent/seanwade-chat
# Remote/production admin login (24–256 random characters; never public).
# Local loopback preview allows admin access automatically.
# ADMIN_PASSWORD=
